# Opcional: aumenta o limite da API e permite consultar repositórios privados.
GITHUB_TOKEN=

# Provedor recomendado para começar sem depender da Vercel.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.8-flash
# Opcional: até dois modelos Google alternativos separados por vírgula.
# Use somente IDs disponíveis na sua conta. Vazio = repetir apenas o principal.
GOOGLE_AI_FALLBACK_MODELS=

# OpenAI direta (opcional). ChatGPT Plus não inclui créditos da API.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6

# Vercel AI Gateway (opcional).
# AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-5.6-luna
